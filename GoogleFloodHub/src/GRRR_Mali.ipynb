    "def get_dataset_with_ID(dict_datasets: Dict[str, xr.Dataset], ID: str) -> xr.Dataset:\n",
    "    if f'ds_{ID}' in dict_datasets:\n",
    "        return dict_datasets[f'ds_{ID}']\n",
    "    elif f'ds_reforecast_{ID}' in dict_datasets:\n",
    "        return dict_datasets[f'ds_reforecast_{ID}']\n",
    "    else:\n",
    "        return None\n",
    "\n",
    "# FIRST, get GRRR data for Bamako:\n",
    "ds_Bamako = get_dataset_with_ID(dict_datasets, 1121916250)\n",
    "df_Bamako = ds_Bamako['streamflow'].to_dataframe().drop(columns = 'gauge_id')\n",
    "df_Bamako = df_Bamako.unstack(level = 'lead_time')\n",
    "df_Bamako.columns = df_Bamako.columns.droplevel()\n",
    "df_Bamako.index = pd.to_datetime(df_Bamako.index)\n",
    "df_Bamako.columns = [f'{col} days' if isinstance(col, int) else col for col in df_Bamako.columns]\n",
    "df_Bamako.to_csv('../data/processed/Bamako/Bamako_streamflow.csv')\n",
    "df_Bamako_4d = pd.DataFrame(df_Bamako['4 days'])\n",
    "df_Bamako_4d.columns = ['Q']\n",
    "df_Bamako_4d['actual_date'] = df_Bamako_4d.index + pd.Timedelta(days = 4)\n",
    "df_Bamako_4d.set_index('actual_date', inplace = True)\n",
    "print('\\nGoogle Flood Hub\\n', type(df_Bamako_4d))\n",
    "print(df_Bamako_4d.head(2))\n",
    "print(df_Bamako_4d.tail(2))\n",
    "\n",
    "# SECOND, we get the corresponding GloFAS v4.0 data for Bamako:\n",
    "df_Bamako_GloFAS = pd.read_csv('../../GloFAS/data/timeseries/discharge_timeseries_Bamako_96.csv')\n",
    "df_Bamako_GloFAS = df_Bamako_GloFAS[['ValidTime', 'percentile_40.0']]\n",
    "df_Bamako_GloFAS.columns = ['ValidTime', 'Q']\n",
    "df_Bamako_GloFAS.columns = ['actual_date', 'Q']\n",
    "df_Bamako_GloFAS['actual_date'] = pd.to_datetime(df_Bamako_GloFAS['actual_date'])\n",
    "df_Bamako_GloFAS.set_index('actual_date', inplace = True)\n",
    "df_Bamako_GloFAS.sort_index(inplace = True)\n",
    "print('\\nGloFAS\\n', type(df_Bamako_GloFAS))\n",
    "print(df_Bamako_GloFAS.head(2))\n",
    "print(df_Bamako_GloFAS.tail(2))\n",
    "\n",
    "# THIRD, we get the corresponding GloFAS v3.0 data for Bamako:\n",
    "df_Bamako_GloFAS_v3 = pd.read_csv('../../GloFAS3/forecasts/discharge_40th_percentile_-8.05_12.55.csv')\n",
    "df_Bamako_GloFAS_v3['ValidTime'] = pd.to_datetime(df_Bamako_GloFAS_v3['ValidTime'])\n",
    "df_Bamako_GloFAS_v3_4lt = df_Bamako_GloFAS_v3[df_Bamako_GloFAS_v3['step'] == '4 days'].copy()\n",
    "df_Bamako_GloFAS_v3_4lt.rename(columns = {'ValidTime': 'actual_date',\n",
    "                                          'Discharge_40th_Percentile': 'Q'}, inplace = True)\n",
    "df_Bamako_GloFAS_v3_4lt.set_index('actual_date', inplace = True)\n",
    "df_Bamako_GloFAS_v3_4lt = pd.DataFrame(df_Bamako_GloFAS_v3_4lt['Q'])\n",
    "print('GloFAS v3\\t', type(df_Bamako_GloFAS_v3_4lt))\n",

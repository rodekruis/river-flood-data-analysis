    "def calculate_RP_Gumbel_pandas(df: pd.DataFrame, RP: float) -> float:\n",
    "    annual_max = calculate_annual_max_pandas(df)\n",
    "    loc, scale = stats.gumbel_r.fit(annual_max)\n",
    "    return stats.gumbel_r.ppf(1 - 1/RP, loc = loc, scale = scale)\n",
    "Bamako_OBS_5yr_RP = calculate_RP_Gumbel_pandas(df_Bamako_obs_melt, 5)\n",
